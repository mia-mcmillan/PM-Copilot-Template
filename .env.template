# Snowflake Connection Configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to git (it's already in .gitignore)

# Snowflake Account (format: just account-region, not full domain)
# Example: ab12345-us-east-1 (NOT ab12345.us-east-1.snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=your-account-region

# Your Snowflake username (often your email)
SNOWFLAKE_USER=your.email@company.com

# Authentication Method - Key-Pair Authentication
# Using RSA private key for non-interactive authentication
SNOWFLAKE_PRIVATE_KEY_FILE="/path/to/your/snowflake_key.p8"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=""  # Optional: only if key is encrypted

# Note: Browser/SSO auth alternative (comment out key file above to use)
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=your_password  # Not needed for key-pair auth

# Warehouse to use for queries (usually COMPUTE_WH)
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE

# Database name containing your data
SNOWFLAKE_DATABASE=YOUR_DATABASE

# Schema (usually PUBLIC unless you have a custom one)
SNOWFLAKE_SCHEMA=PUBLIC

# Role (optional - use if you have a specific role)
SNOWFLAKE_ROLE=YOUR_ROLE

# Optional Configuration for batch exports
GONG_DAYS_BACK=30
PRODUCT_AREA=YourProductArea